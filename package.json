{
  "name": "dsh-bundle-loganz2",
  "version": "0.1.0",
  "description": "A DeepSeek Harness bundle that replaces the stock LLM layer with a pi-ai-native one: OAuth providers and a WebSocket transport toggle.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-llm-pi-login": "./lib/login.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.82.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "typescript": "^5.9.2"
  },
  "license": "MIT"
}
