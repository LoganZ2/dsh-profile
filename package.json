{
  "name": "dsh-bundle-loganz2",
  "version": "0.1.0",
  "description": "A DeepSeek Harness bundle that replaces the stock LLM layer with a pi-ai-native one: OAuth providers and a WebSocket transport toggle.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./bridge": {
      "types": "./lib/bridge/index.d.ts",
      "default": "./lib/bridge/index.js"
    },
    "./settings": {
      "types": "./lib/settings/index.d.ts",
      "default": "./lib/settings/index.js"
    },
    "./anchored": {
      "types": "./lib/anchored/index.d.ts",
      "default": "./lib/anchored/index.js"
    },
    "./permission": {
      "types": "./lib/permission/index.d.ts",
      "default": "./lib/permission/index.js"
    },
    "./tool-fs": {
      "types": "./lib/toolfs/index.d.ts",
      "default": "./lib/toolfs/index.js"
    },
    "./tool-bash": {
      "types": "./lib/toolbash/index.d.ts",
      "default": "./lib/toolbash/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "bin": {
    "llm-pi-login": "./lib/login.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.82.1",
    "diff": "^8.0.2",
    "tree-sitter-bash": "^0.25.0",
    "web-tree-sitter": "^0.25.10"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-session": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.5",
    "typescript": "^5.9.2",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.5"
  },
  "license": "MIT"
}
