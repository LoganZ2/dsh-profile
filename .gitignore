# --- local test harness ---------------------------------------------------
# `home/` is a scratch DSH_HOME used to test this bundle. It is machine-local:
# dsh writes credentials, settings, and full session transcripts into it, and
# its profile manifest holds an absolute `link:` path to this checkout. None of
# that belongs in the repo — this package is the deliverable, not the profile
# that happens to install it.
home/

# --- build output ---------------------------------------------------------
# `lib/` is not tracked: the `prepare` script builds it automatically on
# install, including installs straight from this git URL.
node_modules/
lib/
*.tsbuildinfo

# --- os -------------------------------------------------------------------
.DS_Store
